test("Esther's USD 100 is mandate data, not a product ceiling", () => {
  const esther = mandate("Esther Davis", 100);
  const larger = mandate("Larger Customer", 50_000);
  assert.equal(formAggressiveOrderIntent({ mandate: esther, evidence, symbol: "XYZ", side: "buy", notional: 100, maximumLoss: 100, thesis: "asymmetric repricing", falsifier: "filing disproves catalyst", liquidityPremise: "limit at observed spread", executionPremise: "intent is not a fill" }).concentration, 1);ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;6RntLaIj67jtSIRjwyihpiLVDPw6060gvS0mZ_lNBBQƒdpairƒdleftdstarƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitdunit‚dmark`ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;BQn-b73TF23a4l0CHQnVsTUGsle1VoC7gmbH1Ff68N4ƒdpairƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒdleftdstarƒcsumdunitƒcsumdunitdunit‚dmarkb18ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;JBOhtmaTKEuyssv-fO3tG6330rqG-GaBi0Ja8PJt4ggƒdpairƒerightdunitƒdleftdstarƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitdunit‚dmark`ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;mGwzAYOtBJf6D2ayBfJWArWVGCtY0dfHrqNkNqHjKKQƒdpairƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒdleftdstardunit‚dmarkfAlpacaƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;33yzXa9C6sh9YnvEd1eCQpMaDKoJ8gpbFI17PYiscRUƒdpairƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒdleftdstardunit‚dmarkyútest("compute-payment, brokerage-funding, and provider-revenue wallet roles cannot be conflated", () => {
  const compute = formWalletRoleGrant({ controller: "customer", wallet: "eip155:8453:0x1111111111111111111111111111111111111111", role: "compute-payment", network: "eip155:8453", asset: "USDC", maximumTotalSpend: 25, maximumPerRequest: 2, validUntil: "2027-07-22T00:00:00Z" });
