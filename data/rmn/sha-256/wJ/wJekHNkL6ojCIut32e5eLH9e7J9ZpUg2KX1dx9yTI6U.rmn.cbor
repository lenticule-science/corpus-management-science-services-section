  assert.throws(() => admitMeteredComputePurchase({ walletGrant: funding, quote: { provider: "research-provider", service: "issuer-evidence", price: { amount: 1, asset: "USDC" }, network: "SOL" } }), /compute-payment-wallet/);ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;gRNX1Y_C2Ta8k_D0XjaxCYGaVIt_WJfRSP4i45cWIlUƒdpairƒdleftdstarƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitdunit‚dmark`ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;5bi5T1nUGFcOcwdgbLuVwlfmOgfqjrA5Sm-_AYkRPPYƒdpairƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒdleftdstarƒcsumdunitƒcsumdunitdunit‚dmarkb21ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;La4z7escw4g5xF9Enw_Msx5fi8wSlgwAnQqGwmpA9uEƒdpairƒerightdunitƒdleftdstarƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitdunit‚dmark`ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;5NIjdBq5hqlP-bpPNFCWRpL-FDsMSIxg6l7LOWP4a8Yƒdpairƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒdleftdstardunit‚dmarkfAlpacaƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;7Ec5T239DxAyIo7sCVCWlZwmDmqs3ekJEN5zAfHPbQYƒdpairƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒdleftdstardunit‚dmarky²  assert.equal(admitMeteredComputePurchase({ walletGrant: compute, quote: { provider: "research-provider", service: "issuer-evidence", price: { amount: 1, asset: "USDC" }, network: "eip155:8453" } }).amount, 1);
