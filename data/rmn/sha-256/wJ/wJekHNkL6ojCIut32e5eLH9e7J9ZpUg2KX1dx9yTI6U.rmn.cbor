    const health = await fetch(`${origin}/healthz`); assert.equal(health.status, 200); assert.deepEqual(await health.json(), { status: "ok", service: "coinbase-x402-bazaar-border", network: NETWORK, offers: 6, availableOffers: 6 }); assert.equal(PRICES.alpacaRead, "$0.01"); assert.equal(PRICES.execution, "$0.02");
