     (map ("id" "FAB-R003") ("text" "A reusable circuit definition MUST contain only its law, typed external ports, referenced child component definitions, typed nets, and declared black-box behavior. A separate sovereign assembly MUST place exactly one account, authority, custody, and territory membrane at every contextual occurrence. Definitions and instances MUST NOT embed membranes or accounts."))
     (map ("id" "FAB-R004") ("text" "Organizational scale MUST be derived contextually from recursive topology and membrane relations; operational carriers MUST NOT store enterprise, nation, colony, Union, function, task, or syscall as a flat scale enum."))ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;HndIMqsPKyGeDMIQMWqavHxFL75msuAHPr1bJRS3aEMƒdpairƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒdleftdstardunit‚dmarkgcurrentƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;7fH2lnBAU6xpls-prlpwpdHInc1BEzr447WlGl9QBgQƒdpairƒdleftdstarƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitdunit‚dmark`ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;-psRbkGOqxX7LaMXLSG4YzWzv05HSBaDmGG4K6XXKfAƒdpairƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒdleftdstarƒcsumdunitƒcsumdunitdunit‚dmarke15510ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;R8yBniNqZ_Ga2waKDDHpYyUVESOiigHZC1mhHyZEYh4ƒdpairƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒdleftdstardunit‚dmarkx9ni:///sha-256;ARcoYo-bd-Y0o9BqUdE_AEFiIWCvh6N3__1wywSal5kƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;7tyYWeiMfNgcggvOa35HfuJOWprHrkwtzprQ3HYf56sƒdpairƒerightdunitƒerightdunitƒerightdunitƒdleftdstarƒcsumdunitƒcsumdunitƒcsumdunitdunit‚dmarkefalseƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;-8YEW6NC-uIuI1Qg8iU1IqjWFOhN_cx6C3LEL-pHJVEƒdpairƒerightdunitƒdleftdstarƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitdunit‚dmark`ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;lRhMt1mWDp8YQCrNsUhHKnOqe8jPBNuDxYauTj3wCYgƒdpairƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒerightdunitƒdleftdstardunit‚dmarkosemantic objectƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;U1Sz0lKqSTwKwadbDanKuKWkuzfOJiXpn98gsOwqc3Yƒdpairƒdleftdstarƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitƒcsumdunitdunit‚dmark`ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;uRni5LcbYLlTmHVYNzg1rdVl2C2kz8v3Xeipwc4xzeUƒdpairƒerightdunitƒerightdunitƒ