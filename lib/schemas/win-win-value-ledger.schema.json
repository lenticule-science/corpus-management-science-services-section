{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emsenn:corpus-management-team:schema:win-win-value-ledger",
  "type": "object",
  "required": ["id", "kind", "unit", "entries", "rules"],
  "additionalProperties": false,
  "properties": {
    "id": {"const": "corpus-management-team-value-ledger"},
    "kind": {"const": "win-win-value-ledger"},
    "unit": {"const": "corpus-management-team"},
    "entries": {"type": "array", "maxItems": 0, "$comment": "No entry is admitted until a local evidence-bearing value-entry schema and independent booking authority exist."},
    "rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
