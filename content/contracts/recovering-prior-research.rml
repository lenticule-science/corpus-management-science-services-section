#lang rmn/v2
(map
  ("type" "PriorResearchRecoveryLaw")
  ("version" 1)
  ("provider" "urn:ame:corpus-management-team")
  ("precondition" "A contractor supplies bounded terms and explicit read-only roots, or names one provider-owned recovery by exact contextual and gap bundle identities.")
  ("operation" "The provider searches only authorized territory or projects an already-settled provider recovery, preserving exact source identities, ownership evidence, omissions, and read bounds.")
  ("postcondition" "The contractor receives content-identified ContextualBundle and GapBundle values or a refusal; customer territory is unchanged and every admitted source remains digest-bound.")
  ("refusal" "Refuse missing or changed scope, absent read authority, unbounded search, source-identity loss, silent gaps, provider-result mutation, and customer writes.")
  ("protocol" "ActivityStreams-2.0")
  ("evidence" "RWIL-RDF"))
